# Local development only. PostgreSQL is exposed on loopback.
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar
POSTGRES_DB=calendar
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://calendar:calendar@127.0.0.1:5432/calendar
# Must point to a separate, disposable PostgreSQL database.
TEST_DATABASE_URL=postgresql+psycopg://calendar:calendar@127.0.0.1:5432/calendar_test
API_PROXY_TARGET=http://127.0.0.1:8000
