{
  "name": "call-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:all": "concurrently --kill-others --names api,web \"mise run dev:api\" \"mise run dev:web\"",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p frontend/tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "orval": "8.46.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@scalar/json-magic@0.13.5": {
      "undici": "7.30.1"
    },
    "minimatch": "11.0.3"
  }
}
